{
  "name": "troels-lund-personal-website",
  "version": "1.0.0",
  "description": "personal website of Troels Lund",
  "homepage": "https://troelslund.dk",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "scan": "next dev & npx react-scan@latest localhost:3000",
    "build": "next build",
    "csp:inject": "node scripts/inject-csp.js out",
    "start": "npx serve@latest out",
    "find:unused": "knip",
    "prepare": "husky",
    "test": "jest --runInBand",
    "format": "prettier --write \"**/*.{js,ts,tsx}\"",
    "lint": "NODE_OPTIONS=--require=./scripts/use-typescript6-for-eslint.cjs eslint --cache . --max-warnings=0",
    "lint:fix": "NODE_OPTIONS=--require=./scripts/use-typescript6-for-eslint.cjs eslint --cache . --fix --max-warnings=0",
    "format:lint": "npm run lint:fix && npm run format",
    "optimize-images": "node scripts/optimize-images.js",
    "remove:optimize-images": "node scripts/remove-optimized-images.js",
    "remove:unused": "knip --fix"
  },
  "prepare": "husky || true",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "NODE_OPTIONS=--require=./scripts/use-typescript6-for-eslint.cjs eslint --cache --fix --max-warnings=0"
  },
  "dependencies": {
    "@cronitorio/cronitor-rum": "^0.4.1",
    "@oddbird/popover-polyfill": "^0.7.3",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "gray-matter": "4.0.3",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "react-toastify": "^11.2.0",
    "rehype-katex": "^7.0.1",
    "rehype-meta": "^4.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sass": "^1.107.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript/typescript6": "^6.0.2",
    "babel-plugin-react-compiler": "latest",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^17.0.0",
    "knip": "^6.44.0",
    "postcss": "^8.5.32",
    "postcss-preset-env": "^10.6.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-scan": "^0.5.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "js-yaml": "^3.15.2",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "uuid": "^11.1.1"
  },
  "license": "MIT",
  "engines": {
    "npm": ">=6.0.0",
    "node": ">=20.9.0"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "not ie <= 11"
  ]
}
